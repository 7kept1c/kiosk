106"/><column index="3" value="91"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="наличие_в_аптеке" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="81"/><column index="2" value="106"/><column index="3" value="184"/><column index="4" value="110"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="поставщики_и_производители" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="98"/><column index="2" value="124"/><column index="3" value="111"/><column index="4" value="127"/><column index="5" value="119"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="продажи" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="97"/><column index="2" value="75"/><column index="3" value="76"/><column index="4" value="99"/><column index="5" value="105"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="серии_и_сроки_годности" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="75"/><column index="2" value="106"/><column index="3" value="83"/><column index="4" value="97"/><column index="5" value="139"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="справочник_препаратов" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort><column index="0" mode="0"/></sort><column_widths><column index="1" value="106"/><column index="2" value="186"/><column index="3" value="157"/><column index="4" value="104"/><column index="5" value="513"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">CREATE TABLE &quot;справочник_препаратов&quot; (
    &quot;айди_препарата&quot; INTEGER,
    &quot;название&quot; TEXT NOT NULL,
    &quot;действующее_вещество&quot; TEXT,
    &quot;форма_выпуска&quot; TEXT,
    &quot;условия_хранения&quot; TEXT,
    PRIMARY KEY (&quot;айди_препарата&quot; AUTOINCREMENT)
);</sql><sql name="SQL 2*">CREATE TABLE &quot;аналоги&quot; (
    &quot;айди_связи&quot; INTEGER,
    &quot;айди_препарата&quot; INTEGER,
    &quot;айди_аналога&quot; INTEGER,
    PRIMARY KEY (&quot;айди_связи&quot; AUTOINCREMENT)
);</sql><sql name="SQL 3*">CREATE TABLE &quot;наличие_в_аптеке&quot; (
    &quot;айди_записи&quot; INTEGER,
    &quot;айди_препарата&quot; INTEGER,
    &quot;цена&quot; REAL CHECK(&quot;цена&quot; &gt;= 0),
    &quot;условия_отпуска&quot; TEXT,
    PRIMARY KEY (&quot;айди_записи&quot; AUTOINCREMENT)
);
</sql><sql name="SQL 4*">CREATE TABLE &quot;серии_и_сроки_годности&quot; (
    &quot;айди_серии&quot; INTEGER,
    &quot;айди_препарата&quot; INTEGER,
    &quot;номер_серии&quot; TEXT,
    &quot;срок_годности&quot; TEXT,
    &quot;количество_упаковок&quot; INTEGER,
    PRIMARY KEY (&quot;айди_серии&quot; AUTOINCREMENT)
);</sql><sql name="SQL 5*">CREATE TABLE &quot;поставщики_и_производители&quot; (
    &quot;айди_компании&quot; INTEGER,
    &quot;название_компании&quot; TEXT NOT NULL,
    &quot;тип_компании&quot; TEXT,
    &quot;телефон&quot; TEXT,
    &quot;адрес&quot; TEXT,
    PRIMARY KEY (&quot;айди_компании&quot; AUTOINCREMENT)
);
</sql><sql name="SQL 6*">CREATE TABLE &quot;продажи&quot; (
    &quot;айди_продажи&quot; INTEGER,
    &quot;айди_серии&quot; INTEGER,
    &quot;количество&quot; INTEGER NOT NULL,
    &quot;дата_продажи&quot; TEXT NOT NULL DEFAULT (DATE('now')),
    &quot;итоговая_сумма&quot; REAL,
    PRIMARY KEY (&quot;айди_продажи&quot; AUTOINCREMENT)
);</sql><sql name="SQL 7*">CREATE TABLE &quot;акции_и_скидки&quot; (
    &quot;айди_акции&quot; INTEGER,
    &quot;название_акции&quot; TEXT,
    &quot;размер_скидки_процент&quot; INTEGER,
    &quot;дата_начала&quot; TEXT,
    &quot;дата_окончания&quot; TEXT,
    PRIMARY KEY (&quot;айди_акции&quot; AUTOINCREMENT)
);</sql><sql name="справочник*">INSERT INTO &quot;справочник_препаратов&quot; (&quot;название&quot;, &quot;действующее_вещество&quot;, &quot;форма_выпуска&quot;, &quot;условия_хранения&quot;) VALUES
('Цитрамон-П', 'Ацетилсалициловая кислота', 'Таблетки', 'Сухое, защищенное от света место'),
('Аспирин Кардио', 'Ацетилсалициловая кислота', 'Таблетки', 'При температуре не выше 25 °C'),
('Нурофен', 'Ибупрофен', 'Таблетки', 'В сухом месте'),
('Панадол', 'Парацетамол', 'Таблетки', 'Сухое место'),
('Амбробене', 'Амброксол', 'Сироп', 'При комнатной температуре');</sql><sql name="аналоги*">INSERT INTO &quot;аналоги&quot; (&quot;айди_препарата&quot;, &quot;айди_аналога&quot;) VALUES
(1, 2),
(2, 1),
(3, 4),
(4, 3),
(1, 4);</sql><sql name="наличие*">INSERT INTO &quot;наличие_в_аптеке&quot; (&quot;айди_препарата&quot;, &quot;цена&quot;, &quot;условия_отпуска&quot;) VALUES
(1, 150.99, 'Без рецепта'),
(2, 300.99, 'Без рецепта'),
(3, 500.99, 'Без рецепта'),
(4, 5000.99, 'Без рецепта'),
(5, 700.99, 'По рецепту');
</sql><sql name="серия и срок годности*">INSERT INTO &quot;серии_и_сроки_годности&quot; (&quot;айди_препарата&quot;, &quot;номер_серии&quot;, &quot;срок_годности&quot;, &quot;количество_упаковок&quot;) VALUES
(1, 'SERIA1', '2025-12-01', 50),
(2, 'SERIA2', '2026-05-15', 20),
(3, 'SERIA3', '2024-11-20', 12),
(4, 'SERIA4', '2027-01-10', 30),
(5, 'SERIA5', '2025-08-30', 5);</sql><sql name="поставщик и проивзод*">INSERT INTO &quot;поставщики_и_производители&quot; (&quot;название_компании&quot;, &quot;тип_компании&quot;, &quot;телефон&quot;, &quot;адрес&quot;) VALUES
('Фарма', 'Производитель', '8-800-100-10-10', 'г. Москва'),
('Озон', 'Производитель', '8-800-200-20-20', 'г. Самара'),
('ВБ', 'Производитель', '8-495-123-22-67', 'г. Москва'),
('Аптека Вита', 'Поставщик', '8-999-888-77-66', 'г. Тверь'),
('МедНов', 'Поставщик', '8-999-123-67-67', 'г. Новосибирск');</sql><sql name="продажи*">INSERT INTO &quot;продажи&quot; (&quot;айди_серии&quot;, &quot;количество&quot;, &quot;дата_продажи&quot;, &quot;итоговая_сумма&quot;) VALUES
(1, 2, '2024-05-10', 3444.00),
(2, 1, '2024-05-10', 31111.00),
(3, 1, '2024-05-11', 6000.00),
(1, 3, '2024-05-11', 500.00),
(4, 2, '2024-05-12', 7000.00);</sql><sql name="акции*">INSERT INTO &quot;акции_и_скидки&quot; (&quot;название_акции&quot;, &quot;размер_скидки_процент&quot;, &quot;дата_начала&quot;, &quot;дата_окончания&quot;) VALUES
('Счастливый понедельник', 15, '2026-05-01', '2026-05-31'),
('Скидка пенсионерам', 10, '2026-01-01', '2026-12-31'),
('2+1', 35, '2026-05-15', '2026-06-15'),
('Ночь', 20, '2026-05-01', '2026-08-31'),
('Первый заказ в приложении', 5, '2026-04-01', '2026-12-31');</sql><current_tab id="0"/></tab_sql></sqlb_project>
