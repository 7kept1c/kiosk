VALUES (999, 1, 100.00);</sql><sql name="SQL 4*">CREATE INDEX &quot;idx_наличие_препарат&quot; ON &quot;наличие_в_аптеке&quot; (&quot;айди_препарата&quot;);
CREATE INDEX &quot;idx_серии_препарат&quot; ON &quot;серии_и_сроки_годности&quot; (&quot;айди_препарата&quot;);
CREATE INDEX &quot;idx_продажи_серия&quot; ON &quot;продажи&quot; (&quot;айди_серии&quot;);
CREATE INDEX &quot;idx_препарат_название&quot; ON &quot;справочник_препаратов&quot; (&quot;название&quot;);</sql><current_tab id="3"/></tab_sql></sqlb_project>
